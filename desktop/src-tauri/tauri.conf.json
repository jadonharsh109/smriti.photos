{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smriti",
  "identifier": "photos.smriti.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2NjA3NjREMDA3QzMxOTMKUldTVE1Yd0FUWFpnVmczY3ZZU1d2TWJwM0h6WnJvYmhzL2doWUdoOUpBU3JWaHZWRGxRME1MM1IK",
      "endpoints": [
        "https://github.com/jadonharsh109/smriti.photos/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.icns",
      "../icons/icon.ico"
    ],
    "category": "Photography",
    "shortDescription": "A fully-offline library for your local photos",
    "longDescription": "Smriti turns the photo folders on your drives into a living library — timeline, people, places, events and duplicates — all computed on your own machine. No cloud, no accounts, nothing ever leaves your computer.",
    "resources": {
      "payload/runtime/": "runtime/",
      "payload/bin/": "bin/"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma",
        "languages": ["English"]
      }
    }
  }
}
